<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TicTacToeApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.TicTacToe"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.ui.auth.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.ui.games.GamesListActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.ui.games.CreateGameActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.ui.games.GameActivity"
            android:exported="false" />

    </application>

</manifest>